LISTEN_ADDR=:10443
STORAGE_DIR=/data/uploads
TMP_DIR=/data/upload-tmp
MAX_FILE_SIZE=21474836480
MAX_CONCURRENT_UPLOADS=1
MIN_FREE_SPACE=1073741824
TEMP_FILE_TTL=24h
SHUTDOWN_TIMEOUT=2h
UPLOAD_TOKEN=CHANGE_ME_TO_A_RANDOM_64_HEX_TOKEN
TLS_CERT_FILE=/etc/upload-api/tls/server.crt
TLS_KEY_FILE=/etc/upload-api/tls/server.key
